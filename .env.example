# Copy to .env — the SDK handshake crashes on env_file=None, and every
# client here passes this path unconditionally, so the file must exist even
# if it is empty of secrets.

# Selects the tier-2 overlay directory under .jaato/profiles/.
# Without it the set profiles are not selected and only the
# provider-agnostic _base_* profiles are visible — which bind no
# model, so session creation fails on a missing model_name.
JAATO_PROFILE_SET=openrouter_mixed

# The only credential the shipped profile set needs.
JAATO_OPENROUTER_API_KEY=sk-or-v1-...

# Short on purpose: AF_UNIX caps a socket path at 108 bytes and fails
# opaquely past it.
JAATO_IPC_SOCKET=/tmp/jaato.sock   # the daemon is a singleton; this is where it listens

# The ceiling. No default in code — see monologue.py:_ceiling().
MONOLOGUE_CEILING_USD=2.00
MONOLOGUE_CEILING_TURNS=200

# Enables DRAIN_<TIER>_MESSAGE trace lines, which analyze_run.py needs to
# see a merged batch and its tier mix. Off unless a path is set.
JAATO_PROVIDER_TRACE=/tmp/mono-trace.log
